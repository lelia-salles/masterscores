{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/master-scores",
  "version": "1.0.0",
  "title": "Master Scores",
  "category": "text",
  "icon": "format-audio",
  "description": "Editable musical score block.",
  "attributes": {
    "score": {
      "type": "object",
      "default": {
        "id": "score-default",
        "metadata": {
          "title": "My First Score",
          "composer": "Composer"
        },
        "playback": {
          "bpm": 120,
          "swing": false
        },
        "tracks": [
          {
            "id": "track-001",
            "name": "Piano",
            "instrumentId": "acoustic_grand_piano",
            "measures": [
              {
                "id": "measure-001",
                "index": 0,
                "clef": "treble",
                "timeSignature": "4/4",
                "keySignature": "C",
                "voices": [
                  {
                    "id": "voice-001",
                    "notes": [
                      {
                        "id": "note-1",
                        "keys": ["C4"],
                        "duration": "q",
                        "isRest": false,
                        "dots": 0
                      },
                      {
                        "id": "note-2",
                        "keys": ["D4"],
                        "duration": "q",
                        "isRest": false,
                        "dots": 0
                      },
                      {
                        "id": "note-3",
                        "keys": [],
                        "duration": "q",
                        "isRest": true,
                        "dots": 0
                      },
                      {
                        "id": "note-4",
                        "keys": ["E5", "G5"],
                        "duration": "q",
                        "isRest": false,
                        "dots": 0
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "master-scores",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
